# Copy this file to .env (gitignored, never commit real values) and adjust
# as needed. This file holds only non-secret operational config — the
# actual signal-cli credentials live under ./credentials/, in
# signal-cli's own config-directory format, also gitignored.

# Port the bridge's local HTTP interface listens on. The browser application
# talks to it over localhost only — never exposed beyond that.
PORT=8787

# Path to the signal-cli executable, or just its name if it's on PATH.
SIGNAL_CLI_PATH=signal-cli

# Directory signal-cli stores its own linked-account state in, passed to
# every invocation via --data-dir. Also where the bridge's internal Unix
# socket to signal-cli's own daemon lives (bridge.sock) — chmod 0600 right
# after signal-cli creates it (signal-cli's HTTP mode has no authentication
# of its own, so the bridge uses a permission-scoped Unix socket instead of a
# TCP port for this internal leg — never talked to by the browser either way).
# Point this inside ./credentials/ (already gitignored) so a fresh clone never
# accidentally exposes either the account state or the socket.
SIGNAL_CLI_CONFIG_DIR=./credentials

# Logging (packages/bridge-log, docs/bridge-logging.md). One JSON object per
# line on standard error. All three optional.
#   LOG_LEVEL   debug | info | warn | error   (default info)
#   LOG_FORMAT  json | text                    (default text on a terminal, json otherwise)
#   LOG_FILE    also append every line to this path (created 0600; no rotation —
#               the lines name senders and document ids, so treat the file as
#               sensitive)
LOG_LEVEL=
LOG_FORMAT=
LOG_FILE=
