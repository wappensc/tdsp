# Copy this file to .env (gitignored, never commit real values) and adjust
# as needed. This file holds non-secret *and* secret operational config
# together: MATRIX_ACCESS_TOKEN below is read directly from the environment
# (there is no separate ./credentials/-file-based sign-in step).

# Port the bridge's local HTTP interface listens on. The browser application
# talks to it over localhost only — never exposed beyond that.
PORT=8788

# The Matrix homeserver this bridge's account lives on. Points at the local
# Synapse test server by default, so `pnpm run matrix:up` +
# `pnpm --filter @tdsp/matrix-bridge run start` work together out of the box.
MATRIX_HOMESERVER_URL=http://localhost:18008

# This account's real Matrix access token. With no value, /health reports
# `configured: false` and every real route fails loudly and clearly until it
# is set. Obtain one from a real client's own session, or (for the local test
# homeserver only) with infra/matrix-testserver/login.ts's loginFresh().
MATRIX_ACCESS_TOKEN=

# Where this account's document-id<->room-id bindings (and, alongside them,
# the Olm/Megolm crypto store) persist across restarts. Relative to this
# package's own directory unless given an absolute path; the default
# directory is gitignored, like bridges/signal-bridge's own credentials/.
#
# Running more than one identity on one machine: give each identity its own
# *parent directory* here, not just its own filename. The crypto store path
# is derived as a sibling of this file's own directory, so two identities
# whose paths differ only in filename would share one crypto store.
MATRIX_BIND_STORE_PATH=./credentials/tdsp-channels.json

# Logging (packages/bridge-log, docs/bridge-logging.md). One JSON object per
# line on standard error. All three optional.
#   LOG_LEVEL   debug | info | warn | error   (default info)
#   LOG_FORMAT  json | text                    (default text on a terminal, json otherwise)
#   LOG_FILE    also append every line to this path (created 0600; no rotation —
#               the lines name senders and document ids, so treat the file as
#               sensitive)
LOG_LEVEL=
LOG_FORMAT=
LOG_FILE=
