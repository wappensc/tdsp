# Copy this file to .env (gitignored, never commit real values) and adjust
# as needed. This file holds SMTP/IMAP credentials for a
# single configured mailbox — no separate credentials/ directory format
# to learn, unlike bridges/signal-bridge's own signal-cli config-dir.

# Port the bridge's local HTTP interface listens on. The browser application
# talks to it over localhost only — never exposed beyond that.
PORT=8789

# This mailbox's own address — the From: on every outgoing message and
# this bridge's own MessengerPort MemberId. No default — /health reports
# `configured: false` and every real route fails loudly and clearly
# until this and the SMTP/IMAP settings below are all set.
ADDRESS=

# TLS IS REQUIRED. The bridge talks to a mail server over TLS or
# not at all, and there is no setting that changes that for a remote host:
#   *_SECURE=true   implicit TLS from the first byte (SMTP 465, IMAP 993)
#   *_SECURE=false  STARTTLS, and the bridge REFUSES to continue — before any
#                   password is sent — if the server does not offer it (SMTP 587)
# Certificates are always verified (TLS 1.2 or later). The one exception is a
# server on this machine (localhost, 127.0.0.0/8, ::1) — the local Greenmail test
# server — which may be plaintext; a hostname that merely resolves there does not
# count. GET /mail/status shows how each connection is secured.

# Outgoing mail (nodemailer).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
# The SMTP AUTH login. Leave empty to default to ADDRESS above — true for
# most real providers, where the login genuinely is the email address.
# Set explicitly only when a server's login differs from the mailbox
# address itself — a real case: a local Greenmail
# test server's own `-Dgreenmail.users=alice:pw@example.org` syntax
# creates exactly this split (mailbox alice@example.org, login alice).
SMTP_AUTH_USER=
SMTP_PASS=

# Incoming mail (imapflow). IMAP_AUTH_USER follows the same default-to-
# ADDRESS rule as SMTP_AUTH_USER, kept as its own separate setting since
# a real provider can in principle use a different IMAP login than its
# SMTP one.
IMAP_HOST=
IMAP_PORT=993
IMAP_SECURE=true
IMAP_AUTH_USER=
IMAP_PASS=

# Where this account's document-id<->thread bindings persist across
# restarts. Relative to this package's own directory unless given an
# absolute path; the default directory is gitignored the same way
# bridges/signal-bridge's/bridges/matrix-bridge's own credentials/ already is.
EMAIL_BIND_STORE_PATH=./credentials/tdsp-threads.json

# PGP — relies on the user's own external gpg installation and keyring
# (never generated or held by this bridge). Both optional: GPG_PATH defaults to "gpg"
# (resolved via PATH); GNUPGHOME defaults to gpg's own default
# (~/.gnupg, or $GNUPGHOME if already set in the environment this
# process runs in). If no gpg binary is found at startup, /pgp/status
# reports enabled: false, and a PGP-enabled document can neither send
# (503) nor verify what it receives (rejected, never trusted) — this
# bridge still works fully for PGP-off documents either way. A
# passphrase-protected key (used to sign outgoing and to decrypt incoming
# messages) must already be unlocked in your own gpg-agent, or unlockable
# through your own pinentry; this bridge cannot prompt for a passphrase
# itself.
GPG_PATH=
GNUPGHOME=

# Logging (packages/bridge-log, docs/bridge-logging.md). One JSON object per
# line on standard error. All three optional.
#   LOG_LEVEL   debug | info | warn | error   (default info)
#   LOG_FORMAT  json | text                    (default text on a terminal, json otherwise)
#   LOG_FILE    also append every line to this path (created 0600; no rotation —
#               the lines name senders and document ids, so treat the file as
#               sensitive)
LOG_LEVEL=
LOG_FORMAT=
LOG_FILE=
