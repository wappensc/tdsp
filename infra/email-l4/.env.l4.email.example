# Copy this file to credentials/.env.l4.email (gitignored, never commit real
# values) to run the email adapter's L4 tests (docs/testing.md): two real
# bridge processes on this machine against two real mailboxes at a real provider,
# with throwaway PGP keys generated per run (your own keyring is never touched).
#
#   cp infra/email-l4/.env.l4.email.example infra/email-l4/credentials/.env.l4.email
#   $EDITOR infra/email-l4/credentials/.env.l4.email
#   chmod 600 infra/email-l4/credentials/.env.l4.email
#
# The real file lives under credentials/, not next to this template, like every
# other real credential in this repository.
#
# USE DEDICATED TEST MAILBOXES, NOT A MAILBOX YOU USE. The tests read the whole
# inbox of both accounts and leave the mails they send behind, in the inbox and in
# the sent folder; a provider may also limit how many mails an account can send.
#
# TLS IS REQUIRED. The bridge only ever talks to a mail server over TLS:
#   *_SECURE=true   implicit TLS from the first byte (SMTP 465, IMAP 993)
#   *_SECURE=false  STARTTLS, and the bridge REFUSES to continue without it
#                   (SMTP 587)
# Certificates are always verified; there is no setting to relax that.
# Plaintext is possible only towards localhost (the local Greenmail test server),
# never towards a real host — see bridges/email-bridge/src/tls-policy.ts.
#
# Every value can also be given as an environment variable of the same name,
# which wins over this file.

# ---- Account A: plays the document's creator ("Alice") -----------------------
L4_MAIL_A_ADDRESS=
# The login, if it differs from the address. Empty = the address (true for GMX).
L4_MAIL_A_AUTH_USER=
# The password — or, if the provider offers two-factor authentication or
# "application passwords" and you use them, the application password.
L4_MAIL_A_PASS=

# GMX (as documented by GMX at the time of writing — verify in your account:
# IMAP/POP3 access must be switched on in the GMX web settings first).
L4_MAIL_A_SMTP_HOST=mail.gmx.net
L4_MAIL_A_SMTP_PORT=465
L4_MAIL_A_SMTP_SECURE=true
L4_MAIL_A_IMAP_HOST=imap.gmx.net
L4_MAIL_A_IMAP_PORT=993
L4_MAIL_A_IMAP_SECURE=true

# ---- Account B: plays the participant who joins ("Bob") ----------------------
L4_MAIL_B_ADDRESS=
L4_MAIL_B_AUTH_USER=
L4_MAIL_B_PASS=

L4_MAIL_B_SMTP_HOST=mail.gmx.net
L4_MAIL_B_SMTP_PORT=465
L4_MAIL_B_SMTP_SECURE=true
L4_MAIL_B_IMAP_HOST=imap.gmx.net
L4_MAIL_B_IMAP_PORT=993
L4_MAIL_B_IMAP_SECURE=true
